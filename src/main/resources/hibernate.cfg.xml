<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Απαραίτητες ρυθμίσεις για σύνδεση με το Database της σχολής -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://dblabs.iee.ihu.gr:5432/iee2021065</property>
        <property name="hibernate.connection.username">iee2021065</property>
        <property name="hibernate.connection.password">${db.password}</property>

        <!-- SQL -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Ρυθμίσεις για την εμφάνιση όλων των εκτελεσμένων SQL εντολών στην κονσόλα -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Αυτόματη ενημέρωση του schema από το Hibernate -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Πρόσθεση των πινάκων -->
        <mapping class="com.hotel.model.tables.Customer"/>
        <mapping class="com.hotel.model.tables.Room"/>
        <mapping class="com.hotel.model.tables.Service"/>
        <mapping class="com.hotel.model.tables.Reservation"/>
        <mapping class="com.hotel.model.logs.SystemLogs"/>

    </session-factory>
</hibernate-configuration>